{
  "name": "@adpayon/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json && node --watch dist/src/server.js",
    "dev:sandbox": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json && node --env-file=.env.sandbox --watch dist/src/server.js",
    "dev:test": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json && node --env-file=.env.test --watch dist/src/server.js",
    "build": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json",
    "start": "node dist/src/server.js",
    "start:sandbox": "node --env-file=.env.sandbox dist/src/server.js",
    "start:test": "node --env-file=.env.test dist/src/server.js",
    "typecheck": "node ../../node_modules/typescript/lib/tsc.js --noEmit -p tsconfig.json",
    "test": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json && node --test --test-concurrency=1 dist/tests/health.test.js dist/tests/env.test.js dist/tests/testEnvStartup.test.js dist/tests/models.test.js dist/tests/password.test.js dist/tests/otp.test.js dist/tests/auth.test.js dist/tests/referral.test.js dist/tests/task.test.js dist/tests/adminAuth.test.js dist/tests/taskE2E.test.js dist/tests/sandboxCampaign.test.js dist/tests/taskConcurrency.test.js dist/tests/diagnostics.test.js dist/tests/candidateTxOrdering.test.js dist/tests/cleanupReconciliation.test.js dist/tests/taskVerificationQueue.test.js dist/tests/taskEngineFoundation.test.js dist/tests/videoWatchTask.test.js dist/tests/articleReadTask.test.js dist/tests/appInstallConversionContract.test.js dist/tests/appInstallConversionWebhook.test.js dist/tests/appInstallTaskRoutingAndDiscovery.test.js",
    "test:load": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json && node dist/src/scripts/concurrencyLoadTestHarness.js --",
    "verify:atlas": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json && node dist/src/scripts/verifyTestDbConnectivity.js",
    "verify:sandbox": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json && node --env-file=.env.sandbox dist/src/scripts/verifySandboxIsolation.js",
    "bootstrap:admin": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json && node dist/src/scripts/bootstrapAdmin.js",
    "bootstrap:admin:sandbox": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json && node --env-file=.env.sandbox dist/src/scripts/bootstrapAdminSandbox.js",
    "bootstrap:client-staging": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json && node dist/src/scripts/bootstrapClientStagingReviewers.js",
    "bootstrap:staging-reviewers": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json && node dist/src/scripts/bootstrapClientStagingReviewers.js",
    "migrate:staging-mobile-index": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json && node --env-file=.env.client_staging dist/src/scripts/migrateStagingMobileIndex.js",
    "otp:staging-lookup": "node ../../node_modules/typescript/lib/tsc.js -p tsconfig.json && node dist/src/scripts/lookupStagingReviewerOtp.js"
  },
  "dependencies": {
    "@adpayon/shared": "file:../../packages/shared",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.4",
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "iconv-lite": "^0.4.24",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "typescript": "^5.7.3",
    "zod": "^3.24.1"
  }
}
