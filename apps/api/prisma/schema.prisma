datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  SUPPORT
  FINANCE_AUDITOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
}

// ============================================================================
// 1. Core Users (UUID primary keys, indexed lookups, no raw credentials)
// ============================================================================
model User {
  id               String        @id @default(uuid()) @db.Uuid
  mobile           String        @unique @db.VarChar(15)
  name             String        @db.VarChar(100)
  passwordHash     String        @db.VarChar(255)
  role             Role          @default(USER)
  status           UserStatus    @default(PENDING_VERIFICATION)
  referralCode     String        @unique @db.VarChar(30)
  sponsorId        String?       @db.Uuid
  sponsor          User?         @relation("SponsorshipLine", fields: [sponsorId], references: [id], onDelete: Restrict)
  sponsoredUsers   User[]        @relation("SponsorshipLine")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  sessions         AuthSession[]
  auditLogs        AdminAuditLog[]

  @@index([mobile])
  @@index([referralCode])
  @@index([sponsorId])
  @@map("users")
}

// ============================================================================
// 2. Authentication Sessions (SHA-256 Hashed Refresh Tokens, Family Rotation)
// ============================================================================
model AuthSession {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @db.Uuid
  user             User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  // Store only cryptographic hash (SHA-256) of refresh token; raw token is never persisted
  refreshTokenHash String        @unique @db.VarChar(64)
  familyId         String        @db.Uuid
  userAgent        String?       @db.VarChar(255)
  ipAddress        String?       @db.VarChar(45)
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime      @default(now())

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([familyId])
  @@map("auth_sessions")
}

// ============================================================================
// 3. Admin Audit Trail (Non-repudiation of administrative mutations)
// ============================================================================
model AdminAuditLog {
  id               String        @id @default(uuid()) @db.Uuid
  adminId          String        @db.Uuid
  admin            User          @relation(fields: [adminId], references: [id], onDelete: Restrict)
  action           String        @db.VarChar(100)
  targetEntity     String        @db.VarChar(100)
  targetId         String?       @db.VarChar(100)
  details          Json?
  ipAddress        String        @db.VarChar(45)
  createdAt        DateTime      @default(now())

  @@index([adminId])
  @@index([action])
  @@map("admin_audit_logs")
}

