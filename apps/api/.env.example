# Environment Configuration Template
NODE_ENV=development
PORT=5000
HOST=127.0.0.1
CORS_ORIGIN=*
LOG_LEVEL=info

# MongoDB Atlas Connection (Use placeholders only; never commit actual credentials)
# Development cluster URI format:
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=adpayon_dev

# Authentication Security Secrets (Replace with secure 32+ character secrets in production)
JWT_ACCESS_SECRET=adpayon_dev_jwt_access_secret_do_not_use_in_prod
JWT_REFRESH_SECRET=adpayon_dev_jwt_refresh_secret_do_not_use_in_prod
OTP_HMAC_SECRET=adpayon_dev_otp_hmac_secret_do_not_use_in_prod

# Development OTP Provider (must be false in production)
DEV_OTP_ENABLED=true
