{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "demo",
        "EXPO_PUBLIC_DEMO_MODE": "true"
      }
    },
    "sandbox": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "sandbox",
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_API_URL": "http://127.0.0.1:5001/api"
      }
    },
    "client-staging": {
      "distribution": "internal",
      "developmentClient": false,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_API_URL": "https://adpayon-client-api.onrender.com/api"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_API_URL": "https://api.adpayon.com/api"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
