{
  "expo": {
    "name": "AdPayOn",
    "slug": "adpayon",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.adpayon.app"
    },
    "android": {
      "package": "com.adpayon.app",
      "versionCode": 2,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "scheme": "adpayon",
    "plugins": [
      "expo-secure-store",
      "expo-video",
      "./plugins/withAndroidTargetSdk36",
      [
        "./plugins/withScopedPackageQueries",
        [
          "com.sfarmart.userapp"
        ]
      ],
      "./plugins/withPackageInstallChecker"
    ],
    "extra": {
      "eas": {
        "projectId": "8c8abd01-3ae4-442b-bea4-5ecccf5983f9"
      }
    },
    "owner": "adpayon78"
  }
}
