{
  "name": "adpayon-monorepo",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "mobile": "npm --workspace=@adpayon/mobile start",
    "mobile:sandbox": "npm --workspace=@adpayon/mobile run start:sandbox",
    "mobile:android:sandbox": "npm --workspace=@adpayon/mobile run android:sandbox",
    "api": "npm run --workspace=@adpayon/api dev",
    "api:sandbox": "npm run --workspace=@adpayon/api dev:sandbox",
    "api:test": "npm run --workspace=@adpayon/api dev:test",
    "build:api": "npm run --workspace=@adpayon/api build",
    "typecheck:api": "npm run --workspace=@adpayon/api typecheck",
    "test:api": "npm run --workspace=@adpayon/api test",
    "test:load": "npm run --workspace=@adpayon/api test:load --",
    "verify:atlas": "npm run --workspace=@adpayon/api verify:atlas",
    "verify:sandbox": "npm run --workspace=@adpayon/api verify:sandbox",
    "bootstrap:admin:sandbox": "npm run --workspace=@adpayon/api bootstrap:admin:sandbox",
    "bootstrap:client-staging": "npm run --workspace=@adpayon/api bootstrap:client-staging --",
    "migrate:staging-mobile-index": "npm run --workspace=@adpayon/api migrate:staging-mobile-index --",
    "otp:staging-lookup": "npm run --workspace=@adpayon/api otp:staging-lookup --",
    "admin": "npm run --workspace=@adpayon/admin dev",
    "admin:sandbox": "npm run --workspace=@adpayon/admin dev:sandbox",
    "build:shared": "npm run --workspace=@adpayon/shared build",
    "lint": "npm run --workspaces lint"
  },
  "dependencies": {
    "typescript": "~6.0.3"
  }
}
